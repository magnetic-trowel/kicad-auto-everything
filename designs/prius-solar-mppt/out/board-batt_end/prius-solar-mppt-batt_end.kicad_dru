(version 1)

# HV copper to board edge, IEC 60664-1 Table F.4 PD2 material group IIIa, 500 V row (420 V DC working rounded up) 5.0 mm basic, x 2 reinforced = 10.0 mm, from HV/PACK copper to the board edge and to any mounting hole or screw (the enclosure and screws are CHASSIS) [P: TI SLUP419 table; S: 500 V row]
(rule "IR:edge.HV"
  (condition "(A.hasNetclass('HV') || A.hasNetclass('HV_1A') || A.hasNetclass('PACK_1A'))")
  (constraint edge_clearance (min 10mm)))

# HV copper to mounting holes H701, H702, H703, H704, H705, H706, H901, H902, H903, H904
(rule "IR:edge.HV.holes"
  (condition "(A.hasNetclass('HV') || A.hasNetclass('HV_1A') || A.hasNetclass('PACK_1A')) && (B.memberOfFootprint('H701') || B.memberOfFootprint('H702') || B.memberOfFootprint('H703') || B.memberOfFootprint('H704') || B.memberOfFootprint('H705') || B.memberOfFootprint('H706') || B.memberOfFootprint('H901') || B.memberOfFootprint('H902') || B.memberOfFootprint('H903') || B.memberOfFootprint('H904'))")
  (constraint hole_clearance (min 10mm))
  (constraint clearance (min 10mm)))

# PACK copper to board edge, IEC 60664-1 Table F.4 PD2 material group IIIa, 500 V row (420 V DC working rounded up) 5.0 mm basic, x 2 reinforced = 10.0 mm, from HV/PACK copper to the board edge and to any mounting hole or screw (the enclosure and screws are CHASSIS) [P: TI SLUP419 table; S: 500 V row]
(rule "IR:edge.PACK"
  (condition "(A.hasNetclass('PACK_1A'))")
  (constraint edge_clearance (min 10mm)))

# PACK copper to mounting holes H701, H702, H703, H704, H705, H706, H901, H902, H903, H904
(rule "IR:edge.PACK.holes"
  (condition "(A.hasNetclass('PACK_1A')) && (B.memberOfFootprint('H701') || B.memberOfFootprint('H702') || B.memberOfFootprint('H703') || B.memberOfFootprint('H704') || B.memberOfFootprint('H705') || B.memberOfFootprint('H706') || B.memberOfFootprint('H901') || B.memberOfFootprint('H902') || B.memberOfFootprint('H903') || B.memberOfFootprint('H904'))")
  (constraint hole_clearance (min 10mm))
  (constraint clearance (min 10mm)))

# functional spacing LV to AUXBST, BSTA1, BSTA2, BSTB1, BSTB2, CHASSIS, DCXBST, FANC, IDA, IDB, K1C, K2C, KSUP, V33BST: worst 200.5 V, IPC-2221B B4
(rule "IR:functional.LV.0.4mm"
  (condition "((A.hasNetclass('LV') || A.hasNetclass('LV_10A') || A.hasNetclass('LV_1A') || A.hasNetclass('LV_20A') || A.hasNetclass('LV_8A')) && (B.hasNetclass('AUXBST') || B.hasNetclass('BSTA1') || B.hasNetclass('BSTA2') || B.hasNetclass('BSTB1') || B.hasNetclass('BSTB2') || B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A') || B.hasNetclass('DCXBST') || B.hasNetclass('FANC') || B.hasNetclass('IDA') || B.hasNetclass('IDB') || B.hasNetclass('K1C') || B.hasNetclass('K2C') || B.hasNetclass('KSUP_1A') || B.hasNetclass('V33BST'))) || ((A.hasNetclass('AUXBST') || A.hasNetclass('BSTA1') || A.hasNetclass('BSTA2') || A.hasNetclass('BSTB1') || A.hasNetclass('BSTB2') || A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A') || A.hasNetclass('DCXBST') || A.hasNetclass('FANC') || A.hasNetclass('IDA') || A.hasNetclass('IDB') || A.hasNetclass('K1C') || A.hasNetclass('K2C') || A.hasNetclass('KSUP_1A') || A.hasNetclass('V33BST')) && (B.hasNetclass('LV') || B.hasNetclass('LV_10A') || B.hasNetclass('LV_1A') || B.hasNetclass('LV_20A') || B.hasNetclass('LV_8A')))")
  (constraint clearance (min 0.4mm)))

# reinforced insulation, 420 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.LV.HV.inherited"
  (condition "((A.hasNetclass('AUXBST') || A.hasNetclass('BSTA1') || A.hasNetclass('BSTA2') || A.hasNetclass('BSTB1') || A.hasNetclass('BSTB2') || A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A') || A.hasNetclass('DCXBST') || A.hasNetclass('FANC') || A.hasNetclass('IDA') || A.hasNetclass('IDB') || A.hasNetclass('K1C') || A.hasNetclass('K2C') || A.hasNetclass('KSUP_1A') || A.hasNetclass('LV') || A.hasNetclass('LV_10A') || A.hasNetclass('LV_1A') || A.hasNetclass('LV_20A') || A.hasNetclass('LV_8A') || A.hasNetclass('V33BST')) && (B.hasNetclass('HV') || B.hasNetclass('HV_1A') || B.hasNetclass('PACK_1A'))) || ((A.hasNetclass('HV') || A.hasNetclass('HV_1A') || A.hasNetclass('PACK_1A')) && (B.hasNetclass('AUXBST') || B.hasNetclass('BSTA1') || B.hasNetclass('BSTA2') || B.hasNetclass('BSTB1') || B.hasNetclass('BSTB2') || B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A') || B.hasNetclass('DCXBST') || B.hasNetclass('FANC') || B.hasNetclass('IDA') || B.hasNetclass('IDB') || B.hasNetclass('K1C') || B.hasNetclass('K2C') || B.hasNetclass('KSUP_1A') || B.hasNetclass('LV') || B.hasNetclass('LV_10A') || B.hasNetclass('LV_1A') || B.hasNetclass('LV_20A') || B.hasNetclass('LV_8A') || B.hasNetclass('V33BST')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# reinforced insulation, 399 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.LV.PACK.inherited"
  (condition "((A.hasNetclass('AUXBST') || A.hasNetclass('BSTA1') || A.hasNetclass('BSTA2') || A.hasNetclass('BSTB1') || A.hasNetclass('BSTB2') || A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A') || A.hasNetclass('DCXBST') || A.hasNetclass('FANC') || A.hasNetclass('IDA') || A.hasNetclass('IDB') || A.hasNetclass('K1C') || A.hasNetclass('K2C') || A.hasNetclass('KSUP_1A') || A.hasNetclass('LV') || A.hasNetclass('LV_10A') || A.hasNetclass('LV_1A') || A.hasNetclass('LV_20A') || A.hasNetclass('LV_8A') || A.hasNetclass('V33BST')) && (B.hasNetclass('PACK_1A'))) || ((A.hasNetclass('PACK_1A')) && (B.hasNetclass('AUXBST') || B.hasNetclass('BSTA1') || B.hasNetclass('BSTA2') || B.hasNetclass('BSTB1') || B.hasNetclass('BSTB2') || B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A') || B.hasNetclass('DCXBST') || B.hasNetclass('FANC') || B.hasNetclass('IDA') || B.hasNetclass('IDB') || B.hasNetclass('K1C') || B.hasNetclass('K2C') || B.hasNetclass('KSUP_1A') || B.hasNetclass('LV') || B.hasNetclass('LV_10A') || B.hasNetclass('LV_1A') || B.hasNetclass('LV_20A') || B.hasNetclass('LV_8A') || B.hasNetclass('V33BST')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# reinforced insulation, 420 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.HV.CHASSIS.inherited"
  (condition "((A.hasNetclass('HV') || A.hasNetclass('HV_1A') || A.hasNetclass('PACK_1A')) && (B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A'))) || ((A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A')) && (B.hasNetclass('HV') || B.hasNetclass('HV_1A') || B.hasNetclass('PACK_1A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# functional insulation, 399 V working, IPC-2221B Table 6-1 B2 (301-500 V: 2.5 mm; >500 V: +0.005 mm/V) IPC-2221B B2 via docs/topics/rules/isolation-creepage.md [S]; 5.0 mm also covers the 820 V transient case (4.1 mm) when the converter runs with the relays open (fault)
(rule "IR:barrier.HV.PACK"
  (condition "((A.hasNetclass('HV') || A.hasNetclass('HV_1A')) && (B.hasNetclass('PACK_1A'))) || ((A.hasNetclass('PACK_1A')) && (B.hasNetclass('HV') || B.hasNetclass('HV_1A')))")
  (constraint clearance (min 5mm))
  (constraint creepage (min 5mm)))

# reinforced insulation, 420 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.LV.HV"
  (condition "((A.hasNetclass('LV') || A.hasNetclass('LV_10A') || A.hasNetclass('LV_1A') || A.hasNetclass('LV_20A') || A.hasNetclass('LV_8A')) && (B.hasNetclass('HV') || B.hasNetclass('HV_1A'))) || ((A.hasNetclass('HV') || A.hasNetclass('HV_1A')) && (B.hasNetclass('LV') || B.hasNetclass('LV_10A') || B.hasNetclass('LV_1A') || B.hasNetclass('LV_20A') || B.hasNetclass('LV_8A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# reinforced insulation, 399 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.LV.PACK"
  (condition "((A.hasNetclass('LV') || A.hasNetclass('LV_10A') || A.hasNetclass('LV_1A') || A.hasNetclass('LV_20A') || A.hasNetclass('LV_8A')) && (B.hasNetclass('PACK_1A'))) || ((A.hasNetclass('PACK_1A')) && (B.hasNetclass('LV') || B.hasNetclass('LV_10A') || B.hasNetclass('LV_1A') || B.hasNetclass('LV_20A') || B.hasNetclass('LV_8A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# reinforced insulation, 420 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.HV.CHASSIS"
  (condition "((A.hasNetclass('HV') || A.hasNetclass('HV_1A')) && (B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A'))) || ((A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A')) && (B.hasNetclass('HV') || B.hasNetclass('HV_1A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# reinforced insulation, 399 V working, IEC 60664-1 Tables F.1, F.2, F.4 (DC working voltage) IEC 60664-1 via TI SLUP419 Tables (docs/topics/rules/isolation-creepage.md), DC working voltage = r.m.s. value: F.4 PD2 material group III 400 V row = 4.0 mm basic [P]; 500 V row = 5.0 mm basic [S]; working voltage 420 V DC -> 500 V row -> 10.0 mm reinforced; group I (CTI >= 600) 500 V row 2.5 mm basic -> 5.0 mm reinforced. F.1 <= 600 V OVC II = 4 kV basic, reinforced one step up = 6 kV -> F.2 5.5 mm; design 8.0 mm (matches the G9KB coil-contact clearance). AC test = 6 kV peak / sqrt 2 = 4.24 kVrms
(rule "IR:barrier.PACK.CHASSIS"
  (condition "((A.hasNetclass('PACK_1A')) && (B.hasNetclass('CHASSIS') || B.hasNetclass('CHASSIS_20A'))) || ((A.hasNetclass('CHASSIS') || A.hasNetclass('CHASSIS_20A')) && (B.hasNetclass('PACK_1A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 10mm)))

# pads of one part that bridges spaced domains: C101, U101, Q101, U103, C116, D103, C119, D104, Q103, Q105, C201, U201, Q201, U203, C216, D203, C219, D204, Q203, Q205, Q301, U301, C314, T301, U401, U421, U441, R470, Q461, R481, U461, U505, U601, C603, U602, C610, J705, J704, NT701, K901
# (its package sets that spacing; package creepage is checked against the barrier)
(rule "IR:bridging_parts.1"
  (condition "(A.memberOfFootprint('C101') && B.memberOfFootprint('C101')) || (A.memberOfFootprint('U101') && B.memberOfFootprint('U101')) || (A.memberOfFootprint('Q101') && B.memberOfFootprint('Q101')) || (A.memberOfFootprint('U103') && B.memberOfFootprint('U103')) || (A.memberOfFootprint('C116') && B.memberOfFootprint('C116')) || (A.memberOfFootprint('D103') && B.memberOfFootprint('D103')) || (A.memberOfFootprint('C119') && B.memberOfFootprint('C119')) || (A.memberOfFootprint('D104') && B.memberOfFootprint('D104')) || (A.memberOfFootprint('Q103') && B.memberOfFootprint('Q103')) || (A.memberOfFootprint('Q105') && B.memberOfFootprint('Q105')) || (A.memberOfFootprint('C201') && B.memberOfFootprint('C201')) || (A.memberOfFootprint('U201') && B.memberOfFootprint('U201')) || (A.memberOfFootprint('Q201') && B.memberOfFootprint('Q201')) || (A.memberOfFootprint('U203') && B.memberOfFootprint('U203')) || (A.memberOfFootprint('C216') && B.memberOfFootprint('C216')) || (A.memberOfFootprint('D203') && B.memberOfFootprint('D203')) || (A.memberOfFootprint('C219') && B.memberOfFootprint('C219')) || (A.memberOfFootprint('D204') && B.memberOfFootprint('D204')) || (A.memberOfFootprint('Q203') && B.memberOfFootprint('Q203')) || (A.memberOfFootprint('Q205') && B.memberOfFootprint('Q205')) || (A.memberOfFootprint('Q301') && B.memberOfFootprint('Q301')) || (A.memberOfFootprint('U301') && B.memberOfFootprint('U301')) || (A.memberOfFootprint('C314') && B.memberOfFootprint('C314')) || (A.memberOfFootprint('T301') && B.memberOfFootprint('T301')) || (A.memberOfFootprint('U401') && B.memberOfFootprint('U401')) || (A.memberOfFootprint('U421') && B.memberOfFootprint('U421')) || (A.memberOfFootprint('U441') && B.memberOfFootprint('U441')) || (A.memberOfFootprint('R470') && B.memberOfFootprint('R470')) || (A.memberOfFootprint('Q461') && B.memberOfFootprint('Q461')) || (A.memberOfFootprint('R481') && B.memberOfFootprint('R481')) || (A.memberOfFootprint('U461') && B.memberOfFootprint('U461')) || (A.memberOfFootprint('U505') && B.memberOfFootprint('U505')) || (A.memberOfFootprint('U601') && B.memberOfFootprint('U601')) || (A.memberOfFootprint('C603') && B.memberOfFootprint('C603')) || (A.memberOfFootprint('U602') && B.memberOfFootprint('U602')) || (A.memberOfFootprint('C610') && B.memberOfFootprint('C610')) || (A.memberOfFootprint('J705') && B.memberOfFootprint('J705')) || (A.memberOfFootprint('J704') && B.memberOfFootprint('J704')) || (A.memberOfFootprint('NT701') && B.memberOfFootprint('NT701')) || (A.memberOfFootprint('K901') && B.memberOfFootprint('K901'))")
  (constraint clearance (min 0mm))
  (constraint creepage (min 0mm)))

# pads of one part that bridges spaced domains: K902
# (its package sets that spacing; package creepage is checked against the barrier)
(rule "IR:bridging_parts.2"
  (condition "(A.memberOfFootprint('K902') && B.memberOfFootprint('K902'))")
  (constraint clearance (min 0mm))
  (constraint creepage (min 0mm)))
