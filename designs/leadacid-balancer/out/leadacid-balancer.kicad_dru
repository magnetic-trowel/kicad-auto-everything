(version 1)

# B1 copper to board edge, IEC 60664-1 F.4 PD2 MG IIIa ~1.4 mm at 100 V to hardware and the board edge [S]
(rule "IR:edge.B1"
  (condition "(A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A') || A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH1_SPAN') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH2_SPAN') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB') || A.hasNetclass('CH3_SPAN'))")
  (constraint edge_clearance (min 1.5mm)))

# ISO copper to board edge, as B1
(rule "IR:edge.ISO"
  (condition "(A.hasNetclass('ISO'))")
  (constraint edge_clearance (min 1.5mm)))

# functional spacing B1 to CH1_HSL, CH1_HSU, CH1_LS, CH2_HSL, CH2_HSU, CH2_LS, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 95.5 V, IPC-2221B B2
(rule "IR:functional.B1.0.6mm"
  (condition "((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing B2 to CH1_HSL, CH1_HSU, CH1_QFB, CH2_HSL, CH2_HSU, CH2_LS, CH3_HSL, CH3_HSU, CH3_LS: worst 75.5 V, IPC-2221B B2
(rule "IR:functional.B2.0.6mm"
  (condition "((A.hasNetclass('B2') || A.hasNetclass('B2_10A')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('B2') || B.hasNetclass('B2_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing B3 to CH1_HSL, CH1_HSU, CH1_QFB, CH2_HSL, CH2_HSU, CH2_QFB, CH3_HSL, CH3_HSU, CH3_LS: worst 64.9 V, IPC-2221B B2
(rule "IR:functional.B3.0.6mm"
  (condition "((A.hasNetclass('B3') || A.hasNetclass('B3_10A')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('B3') || B.hasNetclass('B3_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing B4 to CH1_HSL, CH1_HSU, CH1_LS, CH1_QFB, CH2_HSL, CH2_HSU, CH2_QFB, CH3_HSL, CH3_HSU, CH3_QFB: worst 84 V, IPC-2221B B2
(rule "IR:functional.B4.0.6mm"
  (condition "((A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH1_HSU to CH1_HSL, CH1_LS, CH1_QFB, CH2_HSL, CH2_HSU, CH2_LS, CH2_QFB, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 76.5 V, IPC-2221B B2
(rule "IR:functional.CH1_HSU.0.6mm"
  (condition "((A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH1_HSL to CH1_LS, CH1_QFB, CH2_HSL, CH2_HSU, CH2_LS, CH2_QFB, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 96.5 V, IPC-2221B B2
(rule "IR:functional.CH1_HSL.0.6mm"
  (condition "((A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A')) && (B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH1_QFB to CH1_LS, CH2_HSL, CH2_HSU, CH2_LS, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 94.3 V, IPC-2221B B2
(rule "IR:functional.CH1_QFB.0.6mm"
  (condition "((A.hasNetclass('CH1_QFB')) && (B.hasNetclass('CH1_LS') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH1_LS') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH1_QFB')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH1_LS to CH2_HSL, CH2_HSU, CH3_HSL, CH3_HSU, CH3_LS: worst 54.5 V, IPC-2221B B2
(rule "IR:functional.CH1_LS.0.6mm"
  (condition "((A.hasNetclass('CH1_LS')) && (B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('CH1_LS')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH2_HSU to CH2_HSL, CH2_LS, CH2_QFB, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 56.5 V, IPC-2221B B2
(rule "IR:functional.CH2_HSU.0.6mm"
  (condition "((A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A')) && (B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH2_HSL to CH2_LS, CH2_QFB, CH3_HSL, CH3_HSU, CH3_LS, CH3_QFB: worst 76.5 V, IPC-2221B B2
(rule "IR:functional.CH2_HSL.0.6mm"
  (condition "((A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A')) && (B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH2_QFB to CH2_LS, CH3_HSL, CH3_HSU, CH3_LS: worst 74.3 V, IPC-2221B B2
(rule "IR:functional.CH2_QFB.0.6mm"
  (condition "((A.hasNetclass('CH2_QFB')) && (B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('CH2_QFB')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH2_LS to CH3_HSL, CH3_HSU: worst 34.5 V, IPC-2221B B2
(rule "IR:functional.CH2_LS.0.6mm"
  (condition "((A.hasNetclass('CH2_LS')) && (B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A'))) || ((A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A')) && (B.hasNetclass('CH2_LS')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH3_HSU to CH3_HSL, CH3_LS, CH3_QFB: worst 56.5 V, IPC-2221B B2
(rule "IR:functional.CH3_HSU.0.6mm"
  (condition "((A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A')) && (B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH3_HSL to CH3_LS, CH3_QFB: worst 43 V, IPC-2221B B2
(rule "IR:functional.CH3_HSL.0.6mm"
  (condition "((A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A')) && (B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A')))")
  (constraint clearance (min 0.6mm)))

# functional spacing CH3_QFB to CH3_LS: worst 40.8 V, IPC-2221B B2
(rule "IR:functional.CH3_QFB.0.6mm"
  (condition "((A.hasNetclass('CH3_QFB')) && (B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('CH3_LS')) && (B.hasNetclass('CH3_QFB')))")
  (constraint clearance (min 0.6mm)))

# functional insulation, 49.7 V working, IPC-2221B Table 6-1 B2 (external, uncoated) B2 31-50 V: 0.6 mm [S]. A battery domain holds its top tap, so adjacent domains reach 2 Vb + 12.5 V + 2 V (49.7 V operating)
(rule "IR:barrier.B1.B2.inherited"
  (condition "((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A') || A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH1_SPAN') || A.hasNetclass('CH2_SPAN')) && (B.hasNetclass('B2') || B.hasNetclass('B2_10A') || B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB') || B.hasNetclass('CH3_SPAN'))) || ((A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB') || A.hasNetclass('CH3_SPAN')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A') || B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH1_SPAN') || B.hasNetclass('CH2_SPAN')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 49.7 V working, IPC-2221B Table 6-1 B2 (external, uncoated) B2 31-50 V: 0.6 mm [S]. A battery domain holds its top tap, so adjacent domains reach 2 Vb + 12.5 V + 2 V (49.7 V operating)
(rule "IR:barrier.B2.B3.inherited"
  (condition "((A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH3_SPAN')) && (B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('B2') || B.hasNetclass('B2_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH3_SPAN')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 49.7 V working, IPC-2221B Table 6-1 B2 (external, uncoated) B2 31-50 V: 0.6 mm [S]. A battery domain holds its top tap, so adjacent domains reach 2 Vb + 12.5 V + 2 V (49.7 V operating)
(rule "IR:barrier.B3.B4.inherited"
  (condition "((A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_QFB')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 67.3 V working, IPC-2221B Table 6-1 B2 (external, uncoated); IEC 60664-1 Table F.4 PD2 MG IIIa (SLUP419 in repo for 63 V: 1.25 mm [P]; 80-100 V 1.3-1.4 mm [S]) B2 51-100 V: 0.6 mm [S]; F.4 at <= 100 V: 1.4 mm [S]; design 1.5/1.0 mm margin (fails to a fuse, not to shock); worst 3 Vb + 14.5 V
(rule "IR:barrier.B1.B3.inherited"
  (condition "((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A') || A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH1_SPAN') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH2_SPAN') || A.hasNetclass('CH3_SPAN')) && (B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB'))) || ((A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A') || B.hasNetclass('B2') || B.hasNetclass('B2_10A') || B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH1_SPAN') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH2_SPAN') || B.hasNetclass('CH3_SPAN')))")
  (constraint clearance (min 1mm))
  (constraint creepage (min 1.5mm)))

# functional insulation, 67.3 V working, IPC-2221B Table 6-1 B2 (external, uncoated); IEC 60664-1 Table F.4 PD2 MG IIIa (SLUP419 in repo for 63 V: 1.25 mm [P]; 80-100 V 1.3-1.4 mm [S]) B2 51-100 V: 0.6 mm [S]; F.4 at <= 100 V: 1.4 mm [S]; design 1.5/1.0 mm margin (fails to a fuse, not to shock); worst 3 Vb + 14.5 V
