  (constraint clearance (min 1mm))
  (constraint creepage (min 1.5mm)))

# functional insulation, 84.9 V working, IPC-2221B Table 6-1 B2 (external, uncoated); IEC 60664-1 Table F.4 PD2 MG IIIa (SLUP419 in repo for 63 V: 1.25 mm [P]; 80-100 V 1.3-1.4 mm [S]) B2 51-100 V: 0.6 mm [S]; F.4 at <= 100 V: 1.4 mm [S]; design 1.5/1.0 mm margin (fails to a fuse, not to shock); worst 4 Vb + 14.5 V
(rule "IR:barrier.B1.B4.inherited"
  (condition "((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A') || A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH1_SPAN') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH2_SPAN') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_QFB') || A.hasNetclass('CH3_SPAN')) && (B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS'))) || ((A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A') || B.hasNetclass('B2') || B.hasNetclass('B2_10A') || B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH1_SPAN') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH2_SPAN') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_QFB') || B.hasNetclass('CH3_SPAN')))")
  (constraint clearance (min 1mm))
  (constraint creepage (min 1.5mm)))

# basic insulation, 185 V working, IEC 62368-1 ES2 to ES1 basic; IEC 60664-1 F.4 / F.2 F.4 PD2 MG IIIa at 200 V: 2.0 mm creepage [S]; F.2 1.5 kV impulse: 0.5 mm clearance [S]; design 4.0/4.0 mm and no copper under U(k)10 (package >= 7 mm, CTI 175 [P]). v_work = stack 84 V + ALM_E +/-100 V (ASM-11); v_test 1.5 kV DC hi-pot (V-14) = 1.06 kVrms
(rule "IR:barrier.ISO.B1.inherited"
  (condition "((A.hasNetclass('ISO')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A') || B.hasNetclass('B2') || B.hasNetclass('B2_10A') || B.hasNetclass('B3') || B.hasNetclass('B3_10A') || B.hasNetclass('B4') || B.hasNetclass('B4_10A') || B.hasNetclass('B4_5A') || B.hasNetclass('CH1_HSL') || B.hasNetclass('CH1_HSL_10A') || B.hasNetclass('CH1_HSU') || B.hasNetclass('CH1_HSU_10A') || B.hasNetclass('CH1_LS') || B.hasNetclass('CH1_QFB') || B.hasNetclass('CH1_SPAN') || B.hasNetclass('CH2_HSL') || B.hasNetclass('CH2_HSL_10A') || B.hasNetclass('CH2_HSU') || B.hasNetclass('CH2_HSU_10A') || B.hasNetclass('CH2_LS') || B.hasNetclass('CH2_QFB') || B.hasNetclass('CH2_SPAN') || B.hasNetclass('CH3_HSL') || B.hasNetclass('CH3_HSL_10A') || B.hasNetclass('CH3_HSU') || B.hasNetclass('CH3_HSU_10A') || B.hasNetclass('CH3_LS') || B.hasNetclass('CH3_QFB') || B.hasNetclass('CH3_SPAN'))) || ((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A') || A.hasNetclass('B2') || A.hasNetclass('B2_10A') || A.hasNetclass('B3') || A.hasNetclass('B3_10A') || A.hasNetclass('B4') || A.hasNetclass('B4_10A') || A.hasNetclass('B4_5A') || A.hasNetclass('CH1_HSL') || A.hasNetclass('CH1_HSL_10A') || A.hasNetclass('CH1_HSU') || A.hasNetclass('CH1_HSU_10A') || A.hasNetclass('CH1_LS') || A.hasNetclass('CH1_QFB') || A.hasNetclass('CH1_SPAN') || A.hasNetclass('CH2_HSL') || A.hasNetclass('CH2_HSL_10A') || A.hasNetclass('CH2_HSU') || A.hasNetclass('CH2_HSU_10A') || A.hasNetclass('CH2_LS') || A.hasNetclass('CH2_QFB') || A.hasNetclass('CH2_SPAN') || A.hasNetclass('CH3_HSL') || A.hasNetclass('CH3_HSL_10A') || A.hasNetclass('CH3_HSU') || A.hasNetclass('CH3_HSU_10A') || A.hasNetclass('CH3_LS') || A.hasNetclass('CH3_QFB') || A.hasNetclass('CH3_SPAN')) && (B.hasNetclass('ISO')))")
  (constraint clearance (min 4mm))
  (constraint creepage (min 4mm)))

# functional insulation, 49.7 V working, IPC-2221B Table 6-1 B2 (external, uncoated) B2 31-50 V: 0.6 mm [S]. A battery domain holds its top tap, so adjacent domains reach 2 Vb + 12.5 V + 2 V (49.7 V operating)
(rule "IR:barrier.B1.B2"
  (condition "((A.hasNetclass('B1') || A.hasNetclass('B1_10A') || A.hasNetclass('B1_5A')) && (B.hasNetclass('B2') || B.hasNetclass('B2_10A'))) || ((A.hasNetclass('B2') || A.hasNetclass('B2_10A')) && (B.hasNetclass('B1') || B.hasNetclass('B1_10A') || B.hasNetclass('B1_5A')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

