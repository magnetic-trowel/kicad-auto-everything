# pads of one part that bridges spaced domains: J1, Q101, Q102, Q103, R101, R152, R102, R153, C101, C102, C103, C104, C105, C106, C107, C108, C109, C110, C111, C112, C117, U101, U102, R109, R110, R111, C125, C126, C129, C130, D101, D102, U105, R119, C135, C136, R151, R150, C150, R120
# (its package sets that spacing; package creepage is checked against the barrier)
(rule "IR:bridging_parts.1"
  (condition "(A.memberOfFootprint('J1') && B.memberOfFootprint('J1')) || (A.memberOfFootprint('Q101') && B.memberOfFootprint('Q101')) || (A.memberOfFootprint('Q102') && B.memberOfFootprint('Q102')) || (A.memberOfFootprint('Q103') && B.memberOfFootprint('Q103')) || (A.memberOfFootprint('R101') && B.memberOfFootprint('R101')) || (A.memberOfFootprint('R152') && B.memberOfFootprint('R152')) || (A.memberOfFootprint('R102') && B.memberOfFootprint('R102')) || (A.memberOfFootprint('R153') && B.memberOfFootprint('R153')) || (A.memberOfFootprint('C101') && B.memberOfFootprint('C101')) || (A.memberOfFootprint('C102') && B.memberOfFootprint('C102')) || (A.memberOfFootprint('C103') && B.memberOfFootprint('C103')) || (A.memberOfFootprint('C104') && B.memberOfFootprint('C104')) || (A.memberOfFootprint('C105') && B.memberOfFootprint('C105')) || (A.memberOfFootprint('C106') && B.memberOfFootprint('C106')) || (A.memberOfFootprint('C107') && B.memberOfFootprint('C107')) || (A.memberOfFootprint('C108') && B.memberOfFootprint('C108')) || (A.memberOfFootprint('C109') && B.memberOfFootprint('C109')) || (A.memberOfFootprint('C110') && B.memberOfFootprint('C110')) || (A.memberOfFootprint('C111') && B.memberOfFootprint('C111')) || (A.memberOfFootprint('C112') && B.memberOfFootprint('C112')) || (A.memberOfFootprint('C117') && B.memberOfFootprint('C117')) || (A.memberOfFootprint('U101') && B.memberOfFootprint('U101')) || (A.memberOfFootprint('U102') && B.memberOfFootprint('U102')) || (A.memberOfFootprint('R109') && B.memberOfFootprint('R109')) || (A.memberOfFootprint('R110') && B.memberOfFootprint('R110')) || (A.memberOfFootprint('R111') && B.memberOfFootprint('R111')) || (A.memberOfFootprint('C125') && B.memberOfFootprint('C125')) || (A.memberOfFootprint('C126') && B.memberOfFootprint('C126')) || (A.memberOfFootprint('C129') && B.memberOfFootprint('C129')) || (A.memberOfFootprint('C130') && B.memberOfFootprint('C130')) || (A.memberOfFootprint('D101') && B.memberOfFootprint('D101')) || (A.memberOfFootprint('D102') && B.memberOfFootprint('D102')) || (A.memberOfFootprint('U105') && B.memberOfFootprint('U105')) || (A.memberOfFootprint('R119') && B.memberOfFootprint('R119')) || (A.memberOfFootprint('C135') && B.memberOfFootprint('C135')) || (A.memberOfFootprint('C136') && B.memberOfFootprint('C136')) || (A.memberOfFootprint('R151') && B.memberOfFootprint('R151')) || (A.memberOfFootprint('R150') && B.memberOfFootprint('R150')) || (A.memberOfFootprint('C150') && B.memberOfFootprint('C150')) || (A.memberOfFootprint('R120') && B.memberOfFootprint('R120'))")
