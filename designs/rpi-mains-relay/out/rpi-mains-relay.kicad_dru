(version 1)

# LINE copper to board edge, UL 1059/508 field wiring: 1/4 in (6.4 mm) through air and over surface from live parts to dead or grounded metal; a bare EGC may lie against a board edge or a mounting-hole standoff (H3)
(rule "IR:edge.LINE"
  (condition "(A.hasNetclass('LINE_1A') || A.hasNetclass('LINE_W7p5') || A.hasNetclass('NEUTRAL_W7p5') || A.hasNetclass('OUT1_W7p5') || A.hasNetclass('OUT2_W7p5') || A.hasNetclass('OUT3_W7p5') || A.hasNetclass('OUT4_W7p5') || A.hasNetclass('OUT5_W7p5') || A.hasNetclass('OUT6_W7p5'))")
  (constraint edge_clearance (min 6.4mm)))

# LINE copper to mounting holes H1, H2, H3, H4, H5, H6, H7, H8, H9, H10
(rule "IR:edge.LINE.holes"
  (condition "(A.hasNetclass('LINE_1A') || A.hasNetclass('LINE_W7p5') || A.hasNetclass('NEUTRAL_W7p5') || A.hasNetclass('OUT1_W7p5') || A.hasNetclass('OUT2_W7p5') || A.hasNetclass('OUT3_W7p5') || A.hasNetclass('OUT4_W7p5') || A.hasNetclass('OUT5_W7p5') || A.hasNetclass('OUT6_W7p5')) && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4') || B.memberOfFootprint('H5') || B.memberOfFootprint('H6') || B.memberOfFootprint('H7') || B.memberOfFootprint('H8') || B.memberOfFootprint('H9') || B.memberOfFootprint('H10'))")
  (constraint hole_clearance (min 6.4mm))
  (constraint clearance (min 6.4mm)))

# functional insulation, 187 V working, IPC-2221B Table 6-1 B2; IEC 60664-1 F.2 2.5 kV IPC-2221B B2 151-170 V: 1.25 mm [S]; OVC III functional 1.5 mm; design 2.5/1.5 outside the relay footprint
(rule "IR:barrier.LINE.OUT1.inherited"
  (condition "((A.hasNetclass('LINE_1A') || A.hasNetclass('LINE_W7p5') || A.hasNetclass('NEUTRAL_W7p5') || A.hasNetclass('OUT2_W7p5') || A.hasNetclass('OUT3_W7p5') || A.hasNetclass('OUT4_W7p5') || A.hasNetclass('OUT5_W7p5') || A.hasNetclass('OUT6_W7p5')) && (B.hasNetclass('OUT1_W7p5'))) || ((A.hasNetclass('OUT1_W7p5')) && (B.hasNetclass('LINE_1A') || B.hasNetclass('LINE_W7p5') || B.hasNetclass('NEUTRAL_W7p5') || B.hasNetclass('OUT2_W7p5') || B.hasNetclass('OUT3_W7p5') || B.hasNetclass('OUT4_W7p5') || B.hasNetclass('OUT5_W7p5') || B.hasNetclass('OUT6_W7p5')))")
  (constraint clearance (min 1.5mm))
  (constraint creepage (min 2.5mm)))

