# functional insulation, 187 V working, UL 1059 / UL 508 practice UL 1059 use group C, 51-150 V: 1/8 in air, 1/4 in surface [S, secondary table]
(rule "IR:barrier.OUT3.OUT6"
  (condition "((A.hasNetclass('OUT3_W7p5')) && (B.hasNetclass('OUT6_W7p5'))) || ((A.hasNetclass('OUT6_W7p5')) && (B.hasNetclass('OUT3_W7p5')))")
  (constraint clearance (min 3.2mm))
  (constraint creepage (min 6.4mm)))

# functional insulation, 187 V working, UL 1059 / UL 508 practice UL 1059 use group C, 51-150 V: 1/8 in air, 1/4 in surface [S, secondary table]
(rule "IR:barrier.OUT4.OUT5"
  (condition "((A.hasNetclass('OUT4_W7p5')) && (B.hasNetclass('OUT5_W7p5'))) || ((A.hasNetclass('OUT5_W7p5')) && (B.hasNetclass('OUT4_W7p5')))")
  (constraint clearance (min 3.2mm))
  (constraint creepage (min 6.4mm)))

# functional insulation, 187 V working, UL 1059 / UL 508 practice UL 1059 use group C, 51-150 V: 1/8 in air, 1/4 in surface [S, secondary table]
(rule "IR:barrier.OUT4.OUT6"
  (condition "((A.hasNetclass('OUT4_W7p5')) && (B.hasNetclass('OUT6_W7p5'))) || ((A.hasNetclass('OUT6_W7p5')) && (B.hasNetclass('OUT4_W7p5')))")
  (constraint clearance (min 3.2mm))
  (constraint creepage (min 6.4mm)))

# functional insulation, 187 V working, UL 1059 / UL 508 practice UL 1059 use group C, 51-150 V: 1/8 in air, 1/4 in surface [S, secondary table]
(rule "IR:barrier.OUT5.OUT6"
  (condition "((A.hasNetclass('OUT5_W7p5')) && (B.hasNetclass('OUT6_W7p5'))) || ((A.hasNetclass('OUT6_W7p5')) && (B.hasNetclass('OUT5_W7p5')))")
  (constraint clearance (min 3.2mm))
  (constraint creepage (min 6.4mm)))

# reinforced insulation, 187 V working, UL/IEC 62368-1 Tables 10 and 17; IEC 60664-1 Tables F.1, F.2, F.4 TI SLUP419 (Mar 2024) Tables 3-5 and worked example (IEC 60664-1 F.1/F.2/F.4 subsets, IEC 62368-1 Table 10). Required at 120 V OVC III: clearance 3.0 mm (reinforced = 4 kV, F.2), creepage 3.0 mm (2 x F.4 125 V MG III); design 8.0/8.0 matches the relay's own 8/8 mm
(rule "IR:barrier.SELV.LINE"
  (condition "((A.hasNetclass('SELV') || A.hasNetclass('SELV_1A') || A.hasNetclass('SELV_2A')) && (B.hasNetclass('LINE_1A') || B.hasNetclass('LINE_W7p5'))) || ((A.hasNetclass('LINE_1A') || A.hasNetclass('LINE_W7p5')) && (B.hasNetclass('SELV') || B.hasNetclass('SELV_1A') || B.hasNetclass('SELV_2A')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 8mm)))

# pads of one part that bridges spaced domains: J1, PS1, K1, K2, K3, K4, K5, K6, J2, J3, J4
# (its package sets that spacing; package creepage is checked against the barrier)
(rule "IR:bridging_parts.1"
  (condition "(A.memberOfFootprint('J1') && B.memberOfFootprint('J1')) || (A.memberOfFootprint('PS1') && B.memberOfFootprint('PS1')) || (A.memberOfFootprint('K1') && B.memberOfFootprint('K1')) || (A.memberOfFootprint('K2') && B.memberOfFootprint('K2')) || (A.memberOfFootprint('K3') && B.memberOfFootprint('K3')) || (A.memberOfFootprint('K4') && B.memberOfFootprint('K4')) || (A.memberOfFootprint('K5') && B.memberOfFootprint('K5')) || (A.memberOfFootprint('K6') && B.memberOfFootprint('K6')) || (A.memberOfFootprint('J2') && B.memberOfFootprint('J2')) || (A.memberOfFootprint('J3') && B.memberOfFootprint('J3')) || (A.memberOfFootprint('J4') && B.memberOfFootprint('J4'))")
  (constraint clearance (min 0mm))
  (constraint creepage (min 0mm)))
