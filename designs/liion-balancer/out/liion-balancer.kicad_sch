	(text "Li-ion active cell balancer, 13-16S (LT8584 x 16 + ADBMS1818) (rev A)\nBoards: main: tapin, tap0, tap1, tap2, tap3, tap4, tap5, tap6, tap7, tap8, tap9, tap10, tap11, tap12, tap13, tap14, tap15, tap16, ch1, ch2, ch3, ch4,\n    ch5, ch6, ch7, ch8, ch9, ch10, ch11, ch12, ch13, ch14, ch15, ch16, ret, afe, psu, mcu, en, iso, mech; off: harness\nDomains: BAT0 (battery, 0 V = TAP0); C1 (battery, 0 V = TAP0); SW1 (battery, 0 V = TAP0); C2 (battery, 0 V = TAP1); SW2 (battery, 0 V = TAP1); C3\n    (battery, 0 V = TAP2); SW3 (battery, 0 V = TAP2); C4 (battery, 0 V = TAP3); SW4 (battery, 0 V = TAP3); C5 (battery, 0 V = TAP4); SW5 (battery, 0 V\n    = TAP4); C6 (battery, 0 V = TAP5); SW6 (battery, 0 V = TAP5); C7 (battery, 0 V = TAP6); SW7 (battery, 0 V = TAP6); C8 (battery, 0 V = TAP7); SW8\n    (battery, 0 V = TAP7); C9 (battery, 0 V = TAP8); SW9 (battery, 0 V = TAP8); C10 (battery, 0 V = TAP9); SW10 (battery, 0 V = TAP9); C11 (battery, 0\n    V = TAP10); SW11 (battery, 0 V = TAP10); C12 (battery, 0 V = TAP11); SW12 (battery, 0 V = TAP11); C13 (battery, 0 V = TAP12); SW13 (battery, 0 V =\n    TAP12); C14 (battery, 0 V = TAP13); SW14 (battery, 0 V = TAP13); C15 (battery, 0 V = TAP14); SW15 (battery, 0 V = TAP14); C16 (battery, 0 V =\n    TAP15); SW16 (battery, 0 V = TAP15); SNS1 (battery, 0 V = TAP1); SNS2 (battery, 0 V = TAP2); SNS3 (battery, 0 V = TAP3); SNS4 (battery, 0 V =\n    TAP4); SNS5 (battery, 0 V = TAP5); SNS6 (battery, 0 V = TAP6); SNS7 (battery, 0 V = TAP7); SNS8 (battery, 0 V = TAP8); SNS9 (battery, 0 V = TAP9);\n    SNS10 (battery, 0 V = TAP10); SNS11 (battery, 0 V = TAP11); SNS12 (battery, 0 V = TAP12); SNS13 (battery, 0 V = TAP13); SNS14 (battery, 0 V =\n    TAP14); SNS15 (battery, 0 V = TAP15); STACK (battery, 0 V = TAP16); RET (battery, 0 V = TAP0); STR1 (battery, 0 V = STR_Q); STR2 (battery, 0 V =\n    LEDA_1); STR3 (battery, 0 V = LEDA_2); STR4 (battery, 0 V = LEDA_3); STR5 (battery, 0 V = LEDA_4); STR6 (battery, 0 V = LEDA_5); STR7 (battery, 0\n   