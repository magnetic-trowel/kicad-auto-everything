  (condition "((A.hasNetclass('BAT0') || A.hasNetclass('BAT0_3A') || A.hasNetclass('BAT0_W1p5')) && (B.hasNetclass('SW3') || B.hasNetclass('SW3_5A'))) || ((A.hasNetclass('SW3') || A.hasNetclass('SW3_5A')) && (B.hasNetclass('BAT0') || B.hasNetclass('BAT0_3A') || B.hasNetclass('BAT0_W1p5')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

