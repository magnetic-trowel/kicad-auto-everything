# functional insulation, 67.2 V working, IPC-2221B Table 6-1 B2 31-150 V: 0.6 mm external; B1 internal 0.1-0.2 mm [S] DESIGN.md 6.3 B-2. 0.6 mm is the IPC requirement; 1.0 mm preferred on open board. 1.0 mm cannot be held at the LM5164 HSOP-8 (EP to SW 0.75 mm) or ADBMS1818 pins
(rule "IR:barrier.C14.C16"
  (condition "((A.hasNetclass('C14') || A.hasNetclass('C14_3A') || A.hasNetclass('C14_5A') || A.hasNetclass('C14_W1p5')) && (B.hasNetclass('C16') || B.hasNetclass('C16_3A') || B.hasNetclass('C16_5A') || B.hasNetclass('C16_W1p5'))) || ((A.hasNetclass('C16') || A.hasNetclass('C16_3A') || A.hasNetclass('C16_5A') || A.hasNetclass('C16_W1p5')) && (B.hasNetclass('C14') || B.hasNetclass('C14_3A') || B.hasNetclass('C14_5A') || B.hasNetclass('C14_W1p5')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 67.2 V working, IPC-2221B Table 6-1 B2 31-150 V: 0.6 mm external; B1 internal 0.1-0.2 mm [S] DESIGN.md 6.3 B-2. 0.6 mm is the IPC requirement; 1.0 mm preferred on open board. 1.0 mm cannot be held at the LM5164 HSOP-8 (EP to SW 0.75 mm) or ADBMS1818 pins
(rule "IR:barrier.C15.STACK"
  (condition "((A.hasNetclass('C15') || A.hasNetclass('C15_3A') || A.hasNetclass('C15_5A') || A.hasNetclass('C15_W1p5')) && (B.hasNetclass('STACK'))) || ((A.hasNetclass('STACK')) && (B.hasNetclass('C15') || B.hasNetclass('C15_3A') || B.hasNetclass('C15_5A') || B.hasNetclass('C15_W1p5')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 105.7 V working, IPC-2221B Table 6-1 B2 31-150 V [S] DESIGN.md 6.3 B-3: T1kk primary (cell k) to secondary (FLYBUS/TAP0), <= 106 V peak; the footprint gives about 10 mm between pad rows
(rule "IR:barrier.RET.C1"
  (condition "((A.hasNetclass('RET') || A.hasNetclass('RET_2A')) && (B.hasNetclass('C1') || B.hasNetclass('C1_3A') || B.hasNetclass('C1_5A') || B.hasNetclass('C1_W1p5'))) || ((A.hasNetclass('C1') || A.hasNetclass('C1_3A') || A.hasNetclass('C1_5A') || A.hasNetclass('C1_W1p5')) && (B.hasNetclass('RET') || B.hasNetclass('RET_2A')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 67.2 V working, IPC-2221B Table 6-1 B2 31-150 V [S] DESIGN.md 6.3 B-2
(rule "IR:barrier.CTRL.C1"
  (condition "((A.hasNetclass('CTRL')) && (B.hasNetclass('C1') || B.hasNetclass('C1_3A') || B.hasNetclass('C1_5A') || B.hasNetclass('C1_W1p5'))) || ((A.hasNetclass('C1') || A.hasNetclass('C1_3A') || A.hasNetclass('C1_5A') || A.hasNetclass('C1_W1p5')) && (B.hasNetclass('CTRL')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 67.7 V working, IPC-2221B Table 6-1 B2 31-150 V [S] FLYBUS/SEC_k/BUCK_SW (<= 68 V) vs TAP0, GND_B and the logic
(rule "IR:barrier.BAT0.RET"
  (condition "((A.hasNetclass('BAT0') || A.hasNetclass('BAT0_3A') || A.hasNetclass('BAT0_W1p5')) && (B.hasNetclass('RET') || B.hasNetclass('RET_2A'))) || ((A.hasNetclass('RET') || A.hasNetclass('RET_2A')) && (B.hasNetclass('BAT0') || B.hasNetclass('BAT0_3A') || B.hasNetclass('BAT0_W1p5')))")
  (constraint clearance (min 0.6mm))
  (constraint creepage (min 0.6mm)))

# functional insulation, 36 V working, IPC-2221B Table 6-1 B2 31-50 V: 0.6 mm [S] DESIGN.md 6.3 B-6: <= 30 V + 5.5 V; separate connectors J2 and J4
(rule "IR:barrier.USER.FAULT"
  (condition "((A.hasNetclass('USER')) && (B.hasNetclass('FAULT'))) || ((A.hasNetclass('FAULT')) && (B.hasNetclass('USER')))")
  (constraint clearance (min 0.5mm))
  (constraint creepage (min 0.5mm)))

# reinforced insulation, 354 V working, IEC 62368-1, IEC 60664-1 IEC 60664-1 F.4 (250 V, PD2, MG III: 2.5 mm basic -> 5.0 reinforced) and F.2 / IEC 62368-1 Table 10 (3.8 mm at 4 kV) via TI SLUP419 [S]. Required 5.0 / 3.8 mm; design 8.0 / 8.0 mm (ISO7721DWV 8.5 mm package, pad gap 8.85 mm)
(rule "IR:barrier.BAT0.USER"
  (condition "((A.hasNetclass('BAT0') || A.hasNetclass('BAT0_3A') || A.hasNetclass('BAT0_W1p5')) && (B.hasNetclass('USER'))) || ((A.hasNetclass('USER')) && (B.hasNetclass('BAT0') || B.hasNetclass('BAT0_3A') || B.hasNetclass('BAT0_W1p5')))")
  (constraint clearance (min 8mm))
  (constraint creepage (min 8mm)))

# reinforced insulation, 354 V working, IEC 62368-1, IEC 60664-1 IEC 60664-1 F.4 (250 V, PD2, MG III: 2.5 mm basic -> 5.0 reinforced) and F.2 / IEC 62368-1 Table 10 (3.8 mm at 4 kV) via TI SLUP419 [S]. The AQY210EH SMDIP-4 pads leave 5.6 mm, so the fault-contact barrier is held at the required 5.0 / 3.8 mm, not the 8 mm used for the UART
(rule "IR:barrier.BAT0.FAULT"
  (condition "((A.hasNetclass('BAT0') || A.hasNetclass('BAT0_3A') || A.hasNetclass('BAT0_W1p5')) && (B.hasNetclass('FAULT'))) || ((A.hasNetclass('FAULT')) && (B.hasNetclass('BAT0') || B.hasNetclass('BAT0_3A') || B.hasNetclass('BAT0_W1p5')))")
  (constraint clearance (min 3.8mm))
  (constraint creepage (min 5mm)))
